__pycache__/
*.pyc
.venv/
renders/*.blend
renders/test_*
*.blend1
renders/*.log
renders/*_frames/
*.mp4
*.wav
snap_*.png
# The dev plan board is docs/DEV-PLAN.md. The JSON it was generated from is an
# intermediate; edit the markdown directly.
docs/dev-plan.json
# Rust build output
target/
__pycache__/
*.pyc
docs/phase1-playtests/cold-read/*.png
# The vision board (docs/art/vision/). The full-resolution renders are 157 MB; the board
# and index.html point at docs/art/vision/web/, a 900 px JPEG mirror of about 7 MB that is
# tracked. Every probe script is tracked too, so the PNGs can be re-rendered.
docs/art/vision/**/*.png
!docs/art/vision/web/**
docs/art/vision/**/_logs/
docs/art/vision/**/_probes/data/
docs/art/vision/**/__pycache__/
docs/art/vision/**/_bbox/
docs/art/vision/**/*.log
# Godot's per-project import and shader cache. Regenerated on first open.
spikes/godot/*/.godot/
# Cinema spike frame sequences and diagnostic sweeps: hundreds of MB of intermediates.
# The curated pairs, the contract check and the notes are tracked.
spikes/godot/cave/shots/cinema/seq/
spikes/godot/cave/shots/cinema/loc/
spikes/godot/cave/shots/cinema/diag/
spikes/godot/cave/shots/cinema/pairs/
spikes/godot/cave/shots/cinema/contract_on/
spikes/godot/cave/shots/cinema/contract_off/
spikes/godot/cave/shots/cinema/fail/
spikes/godot/cave/**/*.import
spikes/godot/cave/shots/cinema/tune/
spikes/godot/cave/shots/_probe/
spikes/godot/assayer/shots/seq/
spikes/godot/machines/shots/seq/
# Exported machine models: generated from agent_model by agent_model/export_gltf.py, so the
# source of truth is the Blender model and these regenerate. See spikes/godot/machines/NOTES.md.
spikes/godot/machines/models/*.glb
spikes/godot/cloud/shots/cinema/seq/
spikes/godot/cloud/shots/cinema/fx/
spikes/godot/cloud/shots/cinema/fail/
# Surface cinema evidence: 889 MB of sequences and sweeps. The measurements, the code and a
# few key frames under shots/cinema/key/ are tracked; regenerate the rest with --mode=cinema.
spikes/godot/surface/shots/cinema/*/
!spikes/godot/surface/shots/cinema/key/
# Scratch workdir from corridor/cave teaching test runs.
phase2-session/
# Rendered score stems: regenerate with python -m phase1.audio.score_render
spikes/score/*.wav
spikes/trailer_teach/seq/
spikes/trailer_teach/*.mp4
spikes/godot/surface/shots/valley/
