; BLINDSIDE belief point-cloud spike -- Godot 4.7
; The agent's own view. Everything here is drawn from Belief. Nothing is lit.
config_version=5

[application]

config/name="Blindside Belief Cloud"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="viewport"

[rendering]

renderer/rendering_method="forward_plus"
; The cloud is thousands of thin edge-on quads. MSAA is the single cheapest thing that
; stops a disc seen at 80 degrees from aliasing into a dotted line; measured in NOTES.
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=0
environment/defaults/default_clear_color=Color(0.0235, 0.0314, 0.0431, 1)
; No ambient, no fog, no SSAO. The belief layer needs none of it and the truth layer
; is deliberately given only the one non-diegetic survey light.
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
