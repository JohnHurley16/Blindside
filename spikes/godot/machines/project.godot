; BLINDSIDE machines spike -- Godot 4.7
config_version=5

[application]

config/name="Blindside Machines Spike"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"

[rendering]

renderer/rendering_method="forward_plus"
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
; The machines are 0.4-0.9 m long and their detail is at 5-20 mm. A 4096 spot
; atlas over a 6 m lamp throw is 1.5 mm/texel, which is what makes the leg
; shadow land on the hull instead of hovering beside it.
lights_and_shadows/positional_shadow/atlas_size=4096
lights_and_shadows/positional_shadow/atlas_quadrant_0_subdiv=1
